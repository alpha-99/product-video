# PostgreSQL (Supabase or local) - used by Prisma data layer + migration runner
# Supabase 建议使用连接池地址（端口 6543）或直连地址（端口 5432），以实际项目为准。
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/product_video

# Supabase Auth (filled in Phase 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (Phase 7) - OpenAI-compatible /chat/completions
# 密钥只放服务端；AI_MODEL 为主模型，AI_FALLBACK_MODEL 在主模型不可用时接管
# 常见组合（AI_BASE_URL 只写到 /v1，不含 /chat/completions）：
#   DeepSeek  https://api.deepseek.com/v1      deepseek-chat
#   OpenAI    https://api.openai.com/v1        gpt-4o-mini
#   通义千问  https://dashscope.aliyuncs.com/compatible-mode/v1  qwen-plus
#   智谱      https://open.bigmodel.cn/api/paas/v4               glm-4-flash
AI_API_KEY=
AI_MODEL=
AI_FALLBACK_MODEL=
# 兼容代理/自建网关时改这里，默认 https://api.openai.com/v1
AI_BASE_URL=
# 单次调用超时（毫秒），默认 20000
AI_TIMEOUT_MS=
# 成本估算单价（美元 / 1K tokens）；两项都配置才会在用量 meta 里写 costUsd
AI_PRICE_INPUT_PER_1K=
AI_PRICE_OUTPUT_PER_1K=

# Storage root (see section 9 of the design doc)
STORAGE_ROOT=/opt/product-video/data

# ---------------------------------------------------------------------------
# 运维 / 部署（阶段九）。生产完整模板见 deploy/env.production.example
# ---------------------------------------------------------------------------
# 认证：生产默认只认 Supabase Bearer JWT；PV_AUTH_MODE=local 显式开启内测登录
PV_AUTH_MODE=
SUPABASE_JWT_SECRET=
DEV_SESSION_SECRET=
PV_COOKIE_SECURE=
# 健康检查：配置后要求 x-health-token；阈值见 src/lib/ops.ts
HEALTH_TOKEN=
HEALTH_DISK_WARN_PERCENT=
HEALTH_DISK_CRITICAL_PERCENT=
HEALTH_QUEUE_WARN=
HEALTH_QUEUE_CRITICAL=
HEALTH_WORKER_STALE_SEC=
HEALTH_FAILURE_RATE_WARN=
HEALTH_DB_TIMEOUT_MS=
# 告警 Webhook（企业微信 / 飞书 / Slack / 通用 JSON）
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_KIND=
ALERT_REPEAT_MINUTES=
# 备份
BACKUP_DIR=
BACKUP_KEEP_DAYS=
RCLONE_REMOTE=
