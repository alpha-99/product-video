# ProductVideo AI 生产环境变量模板（阶段九）。
# setup-vps.sh 会复制为项目根 .env.production，并自动填充三个随机密钥。
# 规则：所有值用双引号包裹；含 $ ` " \ 的值必须转义或用单引号；禁止提交入库。

# ---------- 必填 ----------
# Supabase Session Pooler（IPv4，端口 5432；用户名必须带 .<project-ref>）。
# 密码里的 ? ! * + 等字符必须 percent 编码；直接复制 Dashboard 给出的连接串。
DATABASE_URL=""
# 数据目录（方案 9.1），需对部署用户可写。
STORAGE_ROOT="/opt/product-video/data"
PORT="3000"

# ---------- 认证（方案 10） ----------
# supabase（正式）：配置 SUPABASE_JWT_SECRET，前端接 Supabase Auth，POST /api/auth/session 返回 403。
# local（内测）：显式开启本地邮箱密码登录，scrypt 密码 + HMAC 签名 HttpOnly Cookie。
#               未开启时生产严格 fail-closed，只认 Bearer JWT。
PV_AUTH_MODE="local"
SUPABASE_JWT_SECRET=""
DEV_SESSION_SECRET=""
# HTTPS 启用后改为 "1"；纯 HTTP 内测必须为 "0"，否则 Secure Cookie 不会被浏览器保存。
PV_COOKIE_SECURE="0"

# ---------- AI 文案（阶段七） ----------
AI_API_KEY=""
AI_BASE_URL="https://api.deepseek.com/v1"
AI_MODEL="deepseek-flash"
AI_FALLBACK_MODEL=""
AI_TIMEOUT_MS="20000"
AI_PRICE_INPUT_PER_1K=""
AI_PRICE_OUTPUT_PER_1K=""

# ---------- 渲染 ----------
RENDER_TIMEOUT_MS="600000"
MAX_CONCURRENT_RENDER="1"
PV_WORKER_ID="worker-1"

# ---------- 健康检查与告警（方案 11） ----------
# 配置后 /api/health 要求 x-health-token 头或 ?token=；留空则对内开放（Nginx 可再加白名单）。
HEALTH_TOKEN=""
HEALTH_URL=""
HEALTH_DISK_WARN_PERCENT="80"
HEALTH_DISK_CRITICAL_PERCENT="92"
HEALTH_QUEUE_WARN="20"
HEALTH_QUEUE_CRITICAL="100"
HEALTH_WORKER_STALE_SEC="120"
HEALTH_FAILURE_RATE_WARN="0.3"
# 跨区连库首次握手可能较慢，默认 8000ms；同区可下调
HEALTH_DB_TIMEOUT_MS="8000"
ALERT_WEBHOOK_URL=""
# wecom | feishu | slack | generic
ALERT_WEBHOOK_KIND="generic"
ALERT_REPEAT_MINUTES="60"
ALERT_STATE_FILE=".ops/alert-state.json"

# ---------- 备份与留存（方案 12.4 / 9.3） ----------
BACKUP_DIR="/opt/product-video/backups"
BACKUP_KEEP_DAYS="14"
RCLONE_REMOTE=""
RETENTION_DAYS="30"
CLEANUP_RENDER_HOURS="24"
