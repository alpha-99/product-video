{
  "name": "product-video-ai",
  "version": "0.1.0",
  "private": true,
  "description": "ProductVideo AI - Next.js Web + Worker monorepo",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "dev:isolated": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/schema.test.ts tests/phase2.test.ts tests/phase3.test.ts tests/render.test.ts tests/thumbnail.test.ts tests/upload.test.ts tests/products.test.ts tests/product-patch.test.ts tests/color.test.ts tests/api-hardening.test.ts tests/asset-security.test.ts tests/acceptance-fixes.test.ts tests/pipeline.test.ts tests/queue.test.ts tests/migration.test.ts tests/prisma-schema.test.ts tests/ai-copy.test.ts tests/phase8.test.ts tests/phase9.test.ts tests/client-cache.test.ts tests/ui-contrast.test.ts tests/ui-audit.test.ts tests/regenerate.test.ts tests/layout-stability.test.ts tests/worker-resilience.test.ts tests/template-preview.test.ts",
    "worker": "tsx src/worker/index.ts",
    "render": "remotion render",
    "compositions": "remotion compositions remotion/index.ts",
    "render:still": "remotion still remotion/index.ts",
    "render:video": "remotion render remotion/index.ts",
    "render:vendor:still": "remotion still remotion/vendor.index.ts vendor-hello-world output/vendor-hello-world.png --frame=45",
    "render:vendor:video": "remotion render remotion/vendor.index.ts vendor-hello-world output/vendor-hello-world.mp4",
    "render:job": "tsx scripts/render-job.ts",
    "process:job": "tsx scripts/process-job.ts",
    "studio": "remotion studio remotion/index.ts",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:check": "tsx scripts/migrate.ts --check",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:check": "tsx scripts/db-check.ts",
    "ai:check": "tsx scripts/ai-check.ts",
    "ops:check": "tsx scripts/ops-check.ts",
    "ops:alert": "tsx scripts/ops-alert.ts",
    "deploy": "bash deploy/deploy.sh",
    "setup:vps": "bash deploy/setup-vps.sh",
    "backup": "bash deploy/backup.sh",
    "restore": "bash deploy/restore.sh"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@remotion/cli": "4.0.547",
    "@remotion/player": "4.0.547",
    "next": "14.2.35",
    "pg": "^8.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.547",
    "dotenv": "^17.3.1",
    "zod": "4.6.7",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2"
  }
}
