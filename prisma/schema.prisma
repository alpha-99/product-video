// ProductVideo AI — 数据访问层 Schema
// 与 db/migrations/001_init.sql 一一对应（表已由迁移脚本创建）。
// 注意：本 Schema 只用于生成类型化客户端，DDL 的唯一真源仍是迁移脚本。
// 不要对已有库执行 `prisma migrate dev`，否则会尝试重建表。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 用户：主键直接复用 Supabase Auth 的 user UUID
model User {
  /// 与 auth.users.id 一致，无默认值
  id         String   @id @db.Uuid
  email      String   @unique @db.VarChar(255)
  /// 剩余免费额度
  quotaLeft  Int      @default(3) @map("quota_left")
  /// 内测本地登录（PV_AUTH_MODE=local）的 scrypt 密码；Supabase Auth 用户保持 NULL
  passwordHash String? @map("password_hash") @db.VarChar(255)
  /// 角色二值：user / admin（管理员唯一判定依据，DB CHECK 约束）
  role       String   @default("user") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  products     Product[]
  videoJobs    VideoJob[]
  subscription Subscription?
  usageRecords UsageRecord[]

  @@map("users")
}

/// 商品
model Product {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 归属用户，级联删除
  userId       String    @map("user_id") @db.Uuid
  name         String    @db.VarChar(200)
  description  String?
  price        Decimal?  @db.Decimal(12, 2)
  /// 相对路径，见方案第 9 章
  imagePath    String    @map("image_path")
  sellingPoints Json     @default("[]") @map("selling_points")
  brandName    String?   @map("brand_name") @db.VarChar(120)
  brandLogoPath String?  @map("brand_logo_path")
  brandColor   String?   @map("brand_color") @db.VarChar(16)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 由数据库触发器 trg_products_updated_at 维护
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoJobs VideoJob[]

  @@index([userId, createdAt(sort: Desc)], name: "idx_products_user")
  @@map("products")
}

/// 视频模板
model VideoTemplate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String   @db.VarChar(120)
  /// launch / highlight / sale / showcase
  category       String   @db.VarChar(60)
  /// Remotion Composition ID
  compositionId  String   @map("composition_id") @db.VarChar(80)
  durationSec    Int      @default(15) @map("duration_sec") @db.SmallInt
  thumbnailPath  String?  @map("thumbnail_path")
  config         Json     @default("{}")
  enabled        Boolean  @default(true)
  /// 运营元数据层（DB 单一真源）
  displayName    String?  @map("display_name") @db.VarChar(120)
  englishName    String?  @map("english_name") @db.VarChar(120)
  description    String?  @map("description") @db.VarChar(300)
  cta            String?  @map("cta") @db.VarChar(60)
  /// 展示色调枚举：energetic/calm/premium/playful/urgent
  tone           String?  @map("tone") @db.VarChar(20)
  sortOrder      Int      @default(0) @map("sort_order")
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?  @map("updated_by") @db.Uuid
  /// 乐观锁（FR-04 并发）
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  videoJobs VideoJob[]

  @@unique([compositionId], name: "uq_templates_composition_id")
  @@index([enabled, category], name: "idx_templates_enabled")
  @@index([sortOrder, compositionId], name: "idx_templates_sort")
  @@map("video_templates")
}

/// 视频任务（队列核心表）
/// 注意：idx_jobs_claim 是带 WHERE status='pending' 的部分索引，
/// Prisma Schema 无法表达，保留在 001_init.sql 中，勿用 migrate 覆盖。
model VideoJob {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  templateId     String    @map("template_id") @db.Uuid
  /// pending / processing / completed / failed / cancelled（DB 层 CHECK 约束）
  status         String    @default("pending")
  /// 已校验的渲染参数快照
  inputJson      Json      @map("input_json")
  outputPath     String?   @map("output_path")
  thumbnailPath  String?   @map("thumbnail_path")
  errorMessage   String?   @map("error_message")
  /// 已尝试次数
  attempt        Int       @default(0) @db.SmallInt
  /// 提交幂等键
  idempotencyKey String    @map("idempotency_key") @db.VarChar(128)
  /// Worker 领取心跳
  leasedAt       DateTime? @map("leased_at") @db.Timestamptz(6)
  /// 租约到期，用于超时回收
  leaseUntil     DateTime? @map("lease_until") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id])
  template     VideoTemplate @relation(fields: [templateId], references: [id])
  usageRecords UsageRecord[]

  @@unique([userId, idempotencyKey], name: "uq_jobs_idem")
  @@index([userId, createdAt(sort: Desc)], name: "idx_jobs_user")
  @@map("video_jobs")
}

/// 订阅（V1.0 后置，先建表占位）
/// plan: starter / pro / agency（DB 层 CHECK 约束）
model Subscription {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  plan      String    @db.VarChar(20)
  status    String    @default("active") @db.VarChar(20)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

/// 用量记录：扣减与返还都记账，便于对账
/// usage_type: consume / refund / grant / ai_call（DB 层 CHECK 约束）
/// amount：扣减为正 / 返还为负；AI 调用只记流水，amount 固定 0
model UsageRecord {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  videoJobId String?  @map("video_job_id") @db.Uuid
  usageType  String   @map("usage_type") @db.VarChar(20)
  amount     Int
  /// AI 调用的 model / token / 来源等附加信息（方案 6.2 成本监控）
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoJob VideoJob? @relation(fields: [videoJobId], references: [id])

  @@index([userId, createdAt(sort: Desc)], name: "idx_usage_user")
  @@map("usage_records")
}

/// AI 文案缓存（方案 6.2）：相同商品内容 + 模板 + 模型命中缓存，TTL 24h。
/// 不存 user_id —— 缓存键只由商品内容决定，跨用户复用不泄漏任何用户数据。
model AiCopyCache {
  cacheKey  String   @id @map("cache_key") @db.VarChar(64)
  payload   Json
  model     String?  @db.VarChar(120)
  source    String   @default("model") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt], name: "idx_ai_cache_expires")
  @@map("ai_copy_cache")
}

/// Worker 心跳（方案 11 / 阶段九）：由 Worker 进程定时 UPSERT，
/// /api/health 与告警脚本据此判断「进程还活着但队列没动」这类静默故障。
model WorkerHeartbeat {
  workerId   String   @id @map("worker_id") @db.VarChar(120)
  hostname   String?  @db.VarChar(255)
  status     String   @default("running") @db.VarChar(20)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  meta       Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([lastSeenAt], name: "idx_worker_heartbeats_seen")
  @@map("worker_heartbeats")
}

/// 模板写操作审计：与主操作同一事务，写失败整笔回滚。
/// actor_user_id 用标量 UUID（不建 Prisma relation，避免与 users 的多重关系歧义）。
model TemplateAuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId  String   @map("template_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(32)
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([templateId, createdAt(sort: Desc)], name: "idx_tpl_audit_template")
  @@map("template_audit_logs")
}

/// 角色变更审计：web / script 全量留痕；不记邮箱明文。
model UserRoleAuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetUserId String   @map("target_user_id") @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  actorLabel   String?  @map("actor_label") @db.VarChar(120)
  source       String   @db.VarChar(20)
  requestId    String?  @map("request_id") @db.Uuid
  fromRole     String   @map("from_role") @db.VarChar(20)
  toRole       String   @map("to_role") @db.VarChar(20)
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([targetUserId, createdAt(sort: Desc)], name: "idx_role_audit_target")
  @@map("user_role_audit_logs")
}

/// 提权复核单：双人复核凭据；过期由列表读取时惰性置位，不依赖定时任务。
model UserRoleChangeRequest {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetUserId String    @map("target_user_id") @db.Uuid
  fromRole     String    @default("user") @map("from_role") @db.VarChar(20)
  toRole       String    @map("to_role") @db.VarChar(20)
  requestedBy  String    @map("requested_by") @db.Uuid
  reason       String
  status       String    @default("pending") @db.VarChar(20)
  reviewedBy   String?   @map("reviewed_by") @db.Uuid
  reviewReason String?   @map("review_reason")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz(6)

  /// 部分唯一索引 uq_role_req_pending(target_user_id) WHERE status='pending'
  /// Prisma 无法表达，保留在 005_template_admin.sql 中，勿用 migrate 覆盖。
  @@index([targetUserId, status], name: "idx_role_req_target_status")
  @@index([status, expiresAt], name: "idx_role_req_status_expiry")
  @@map("user_role_change_requests")
}
